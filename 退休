<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>退休需要存多少錢？名目總花費試算</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@300;400;500;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Noto Sans TC', sans-serif;
            background-color: #F4F1EA; /* 溫潤米咖色背景 */
            color: #4A3B32;
        }
    </style>
</head>
<body class="min-h-screen py-8 px-4 flex flex-col items-center justify-center">

    <div class="max-w-md w-full bg-[#EBE5D8] border border-[#D5CCC0] rounded-2xl shadow-xl p-6 sm:p-8">
        <!-- 標題 -->
        <h1 class="text-2xl sm:text-3xl font-bold text-center text-[#5C4B40] mb-2 tracking-wide">退休需要存多少錢？</h1>
        <h2 class="text-lg font-medium text-center text-[#8C7A6B] mb-6">名目總花費試算</h2>
        <div class="w-16 h-0.5 bg-[#C2B5A3] mx-auto mb-8"></div>

        <!-- 輸入區塊 -->
        <div class="space-y-4">
            <!-- 每月想過的生活費 -->
            <div class="bg-[#DFD8CC] p-4 rounded-xl border border-[#D0C6B8] transition-all focus-within:ring-2 focus-within:ring-[#A68A72]">
                <label class="block text-xs font-semibold text-[#7A6A5C] mb-1">每月想過的生活費</label>
                <div class="flex items-center justify-between">
                    <input type="number" id="monthlyExpense" value="30000" class="w-full bg-transparent text-2xl font-bold text-[#4A3B32] focus:outline-none" placeholder="30000">
                    <span class="text-sm font-medium text-[#7A6A5C] whitespace-nowrap ml-2">元 / 月</span>
                </div>
            </div>

            <!-- 現在年齡與退休年齡 -->
            <div class="grid grid-cols-2 gap-4">
                <div class="bg-[#DFD8CC] p-4 rounded-xl border border-[#D0C6B8]">
                    <label class="block text-xs font-semibold text-[#7A6A5C] mb-1">現在年齡</label>
                    <div class="flex items-center justify-between">
                        <input type="number" id="currentAge" value="35" class="w-full bg-transparent text-2xl font-bold text-[#4A3B32] focus:outline-none">
                        <span class="text-sm font-medium text-[#7A6A5C] ml-2">歲</span>
                    </div>
                </div>
                <div class="bg-[#DFD8CC] p-4 rounded-xl border border-[#D0C6B8]">
                    <label class="block text-xs font-semibold text-[#7A6A5C] mb-1">退休年齡</label>
                    <div class="flex items-center justify-between">
                        <input type="number" id="retirementAge" value="65" class="w-full bg-transparent text-2xl font-bold text-[#4A3B32] focus:outline-none">
                        <span class="text-sm font-medium text-[#7A6A5C] ml-2">歲</span>
                    </div>
                </div>
            </div>

            <!-- 預期壽命與年通膨率 -->
            <div class="grid grid-cols-2 gap-4">
                <div class="bg-[#DFD8CC] p-4 rounded-xl border border-[#D0C6B8]">
                    <label class="block text-xs font-semibold text-[#7A6A5C] mb-1">預期壽命</label>
                    <div class="flex items-center justify-between">
                        <input type="number" id="lifeExpectancy" value="95" class="w-full bg-transparent text-2xl font-bold text-[#4A3B32] focus:outline-none">
                        <span class="text-sm font-medium text-[#7A6A5C] ml-2">歲</span>
                    </div>
                </div>
                <div class="bg-[#DFD8CC] p-4 rounded-xl border border-[#D0C6B8]">
                    <label class="block text-xs font-semibold text-[#7A6A5C] mb-1">年通膨率</label>
                    <div class="flex items-center justify-between">
                        <input type="number" id="inflationRate" value="4" step="0.1" class="w-full bg-transparent text-2xl font-bold text-[#4A3B32] focus:outline-none">
                        <span class="text-sm font-medium text-[#7A6A5C] ml-2">%</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- 計算公式提示 -->
        <div class="mt-6 bg-[#DFD8CC] p-4 rounded-xl border border-[#D0C6B8] text-center">
            <p class="text-xs font-semibold text-[#7A6A5C] mb-1">計算公式</p>
            <p id="formulaText" class="text-xs text-[#5C4B40] font-mono overflow-x-auto py-1">
                30,000 × (1+4%)³⁰ × [...]
            </p>
        </div>

        <!-- 計算結果展示 -->
        <div class="mt-6 bg-[#5C4B40] text-[#F4F1EA] p-6 rounded-2xl shadow-inner text-center">
            <p class="text-xs font-medium tracking-wider text-[#D5CCC0] mb-1">退休後名目總花費</p>
            <div class="flex items-baseline justify-center space-x-2 my-2">
                <span id="totalCost" class="text-4xl sm:text-5xl font-extrabold tracking-tight">6,753</span>
                <span class="text-xl font-bold text-[#D5CCC0]">萬</span>
            </div>
            <p class="text-sm text-[#D5CCC0] border-t border-[#7A6A5C] pt-3 mt-3">
                退休當月月支出：<span id="initialRetirementMonthly" class="font-bold text-white">97,302</span> 元
            </p>

            <!-- 三階段分段花費 -->
            <div class="grid grid-cols-3 gap-2 mt-5 pt-4 border-t border-[#7A6A5C] text-center">
                <div>
                    <p id="phase1Label" class="text-[11px] text-[#C2B5A3]">65-75 歲</p>
                    <p id="phase1Cost" class="text-sm sm:text-base font-bold text-white mt-0.5">1,433 萬</p>
                </div>
                <div class="border-x border-[#7A6A5C]">
                    <p id="phase2Label" class="text-[11px] text-[#C2B5A3]">75-85 歲</p>
                    <p id="phase2Cost" class="text-sm sm:text-base font-bold text-white mt-0.5">2,121 萬</p>
                </div>
                <div>
                    <p id="phase3Label" class="text-[11px] text-[#C2B5A3]">85-95 歲</p>
                    <p id="phase3Cost" class="text-sm sm:text-base font-bold text-white mt-0.5">3,139 萬</p>
                </div>
            </div>
        </div>

        <!-- 品牌簽名 -->
        <div class="text-center mt-6 text-xs text-[#8C7A6B] font-medium">
            理財規劃專用試算工具
        </div>
    </div>

    <script>
        function calculateRetirement() {
            const monthly = parseFloat(document.getElementById('monthlyExpense').value) || 0;
            const currentAge = parseFloat(document.getElementById('currentAge').value) || 0;
            const retirementAge = parseFloat(document.getElementById('retirementAge').value) || 0;
            const lifeExpectancy = parseFloat(document.getElementById('lifeExpectancy').value) || 0;
            const inflation = (parseFloat(document.getElementById('inflationRate').value) || 0) / 100;

            const yearsToRetirement = Math.max(0, retirementAge - currentAge);
            const retirementDuration = Math.max(0, lifeExpectancy - retirementAge);

            // 退休當月月支出 (考慮通膨)
            const initialRetirementMonthly = monthly * Math.pow(1 + inflation, yearsToRetirement);

            // 分階段計算 (每 10 年一區段，或按剩餘年限均分 3 段)
            let totalCost = 0;
            let phaseCosts = [0, 0, 0];
            
            const segmentYears = retirementDuration / 3;
            let currentMonthly = initialRetirementMonthly;

            for (let i = 0; i < 3; i++) {
                let segmentTotal = 0;
                for (let m = 0; m < (retirementDuration / 3) * 12; m++) {
                    segmentTotal += currentMonthly;
                    // 每年複利遞增通膨
                    if ((m + 1) % 12 === 0) {
                        currentMonthly *= (1 + inflation);
                    }
                }
                phaseCosts[i] = segmentTotal;
                totalCost += segmentTotal;
            }

            const totalInTenThousand = Math.round(totalCost / 10000);
            
            // 更新畫面
            document.getElementById('totalCost').innerText = totalInTenThousand.toLocaleString();
            document.getElementById('initialRetirementMonthly').innerText = Math.round(initialRetirementMonthly).toLocaleString();

            document.getElementById('phase1Label').innerText = `${retirementAge}-${retirementAge + Math.floor(retirementDuration/3)} 歲`;
            document.getElementById('phase1Cost').innerText = (Math.round(phaseCosts[0]/10000)).toLocaleString() + ' 萬';

            document.getElementById('phase2Label').innerText = `${retirementAge + Math.floor(retirementDuration/3)}-${retirementAge + Math.floor(retirementDuration*2/3)} 歲`;
            document.getElementById('phase2Cost').innerText = (Math.round(phaseCosts[1]/10000)).toLocaleString() + ' 萬';

            document.getElementById('phase3Label').innerText = `${retirementAge + Math.floor(retirementDuration*2/3)}-${lifeExpectancy} 歲`;
            document.getElementById('phase3Cost').innerText = (Math.round(phaseCosts[2]/10000)).toLocaleString() + ' 萬';

            // 更新公式顯示文字
            document.getElementById('formulaText').innerText = 
                `${monthly.toLocaleString()} × (1+${(inflation*100).toFixed(1)}%)${yearsToRetirement} × [...]`;
        }

        // 綁定監聽事件
        ['monthlyExpense', 'currentAge', 'retirementAge', 'lifeExpectancy', 'inflationRate'].forEach(id => {
            document.getElementById(id).addEventListener('input', calculateRetirement);
        });

        // 初始計算一次
        calculateRetirement();
    </script>
</body>
</html>
